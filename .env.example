# Fictitious values only. Copy to .env (permissions 600) and fill in locally.
HUB_DB_URL=jdbc:postgresql://localhost:5432/zio_hub
HUB_DB_USER=zio_hub
HUB_DB_PASSWORD=change-me
EDGE_DB_URL=jdbc:postgresql://localhost:5432/zio_edge
EDGE_DB_USER=zio_edge
EDGE_DB_PASSWORD=change-me
HUB_JWT_SECRET=change-me-at-least-32-random-bytes
# false only for local http development
HUB_COOKIE_SECURE=true
# Hub command signing key (Ed25519, file with 600 permissions, created on first start if missing)
HUB_SIGNING_KEY_FILE=/path/outside/the/repository/hub-command-signing.key
